{
  "extends": [
    "markuplint:recommended"
  ],
  "parser": {
    ".astro$": "@markuplint/astro-parser"
  },
  "nodeRules": [
    {
      "regexSelector": {
        "nodeName": "/^[A-Z]/"
      },
      "rules": {
        "permitted-contents": false,
        "no-unclosed-element-at-eof": false
      }
    },
    {
      "selector": "ul:has(> slot)",
      "rules": {
        "permitted-contents": false
      }
    }
  ]
}
